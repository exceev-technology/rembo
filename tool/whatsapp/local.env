# Local values for `supabase functions serve` only: nothing real here.
# tool/whatsapp/simulate.py plays Meta and Gemini on port 8765, with the
# same paths as the real services (see supabase/README.md for real values).
WHATSAPP_VERIFY_TOKEN=verif-local
WHATSAPP_APP_SECRET=secret-local-de-test
WHATSAPP_TOKEN=jeton-local-factice
WHATSAPP_PHONE_NUMBER_ID=0
WHATSAPP_GRAPH_URL=http://host.docker.internal:8765
RECEIPT_API_URL=http://host.docker.internal:8765/v1beta/openai
RECEIPT_MODEL=simulateur
TRANSCRIBE_API_URL=http://host.docker.internal:8765/v1beta
TRANSCRIBE_MODEL=simulateur
