# Copy to `.env` and run: flutter run --dart-define-from-file=.env
# `.env` is git-ignored. Only PUBLIC client values belong here.
# NEVER put the Supabase service_role key or OCR / AI provider keys in this file:
# they live in Supabase Edge Function secrets (`supabase secrets set ...`).
#
# Without these two values the app starts in demonstration mode
# (fictional data, nothing saved). Setup steps: supabase/README.md

# Hosted project: Project Settings → API (URL and publishable / anon key).
# Local stack: printed by `supabase start`
# Android emulator: use http://10.0.2.2:54321 instead of 127.0.0.1
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key

# Without the two SUPABASE values the app keeps real accounts and expenses on
# the phone only. Set to true for the fictional demo instead.
REMBO_DEMO=false

# Set to true only once the `read-receipt` Edge Function is deployed.
REMBO_OCR=false

# WhatsApp number of the company's REMBO line, digits only with country code
# (e.g. 212600000000). Leave empty until the line exists.
REMBO_WHATSAPP_NUMBER=
