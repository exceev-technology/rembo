# Copy to `.env` and run: flutter run --dart-define-from-file=.env
# `.env` is git-ignored. Only PUBLIC client values belong here.
# NEVER put the Supabase service_role key or OCR / AI provider keys in this file:
# they live in Supabase Edge Function secrets (`supabase secrets set ...`).

# Local stack: printed by `supabase start`
# Android emulator: use http://10.0.2.2:54321 instead of 127.0.0.1
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
